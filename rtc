#!/bin/sh
# rtc - host a coding agent on this Mac and make it usable from any machine
# that joins over rt. The agent runs here (the host), but does its work back on
# the machine you connect from, through rt's `peer` command.
#
# It prepares a workspace with an AGENTS.md (and a CLAUDE.md alias, for Claude
# Code) that tells the agent where to work, pre-allows `peer` for Claude Code,
# then starts `rt -b`.
#
# Usage: rtc [-a] [-A cmd] [extra rt options]
#   -a, --auto    auto-start the agent on connect (no need to type it)
#   -A, --agent cmd   agent command (default: $RTC_AGENT, else "claude")
#   RTC_WORKSPACE     workspace path (default: ~/.local/state/rt/agent)
#
# Examples:
#   rtc                           # connect, then run the agent yourself
#   rtc -a                        # auto-start claude (default) on connect
#   rtc -a -A codex               # auto-start codex instead
#   RTC_AGENT=codex rtc -a -h -p  # same, args after flags pass through to rt
set -eu

WS="${RTC_WORKSPACE:-$HOME/.local/state/rt/agent}"
AGENT="${RTC_AGENT:-claude}"
AUTO=0

while [ $# -gt 0 ]; do
    case "$1" in
        -a|--auto) AUTO=1; shift ;;
        -A|--agent)
            [ $# -ge 2 ] || { echo "rtc: -A needs an argument" >&2; exit 2; }
            AGENT="$2"; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done

command -v rt >/dev/null 2>&1 ||
    { echo "rtc: rt is not installed (run 'make install' in the rt repo)" >&2; exit 1; }

if [ "$AUTO" = 1 ]; then
    # Check the first token of the agent command.
    agent_bin=$(printf '%s\n' "$AGENT" | awk '{print $1}')
    command -v "$agent_bin" >/dev/null 2>&1 ||
        echo "rtc: warning: agent command '$agent_bin' is not on PATH" >&2
fi

mkdir -p "$WS/.claude"

cat > "$WS/AGENTS.md" <<'EOF'
# You are a remote agent hosted on a Mac, reached over rt

You run on a host Mac through `rt`. The person you are helping is on a DIFFERENT
machine - their own computer, which they connected FROM. Your job is to do the
work on THEIR machine, not on this host Mac.

## Where to do the work

- Their machine is reachable only through `peer`, which runs one command on it:
  `peer <cmd>`. Examples: `peer uname -a`, `peer 'ls -la ~'`, `peer pwd`.
- `RT_PEER_PORT` and `RT_PEER_USER` are already set and `peer` is passwordless.
  Run `peer hostname` once to see which machine you are acting on.
- If `peer` prints "not bidirectional", they joined without `ssh -R`; ask them
  to reconnect with the bidirectional join command rt printed.

## Rules

- Do the user's real work on THEIR machine with `peer`. Read files with
  `peer 'cat path'`, list with `peer 'ls ...'`, run their tools with `peer ...`.
- To create or change a file on their machine, write it through `peer`, e.g.
  `peer "cat > ~/notes.txt" <<'DONE'` ... `DONE`, or
  `peer "printf '%s\n' '...' > ~/notes.txt"`.
- Do NOT use your Write/Edit tools or plain shell for the user's files - those
  only touch this host Mac, which is not what they want. This Mac is only for
  scratch space you explicitly need.
- When unsure where something will land, check with `peer pwd` first.
EOF

# Claude Code reads CLAUDE.md; other agents read AGENTS.md. Point them at the
# same file so edits stay in sync.
ln -sf AGENTS.md "$WS/CLAUDE.md"

# Pre-clear Claude Code's permission gate for `peer`. Harmless for other agents.
cat > "$WS/.claude/settings.json" <<'EOF'
{
  "permissions": {
    "allow": ["Bash(peer:*)"]
  }
}
EOF

echo "rtc: workspace ready at $WS"
echo "rtc: AGENTS.md written (CLAUDE.md -> AGENTS.md); peer pre-allowed for claude"
cd "$WS"
if [ "$AUTO" = 1 ]; then
    echo "rtc: auto-start on; connecting drops straight into '$AGENT'"
    echo "rtc: from the other machine, join with the -b command below."
    echo
    exec rt -b -C "$AGENT" "$@"
fi
echo "rtc: starting 'rt -b $*'; from the other machine, join with the -b command below,"
echo "rtc: then run '$AGENT' (or any agent you prefer) in the session."
echo
exec rt -b "$@"
